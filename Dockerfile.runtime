# Runtime image for the MuseTera bot on the VPS.
# The app is built beforehand (pnpm build -> dist/); this image only
# installs production dependencies and runs the bundled server.
FROM node:22-alpine
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
# Full install: the bundled server imports `vite` at runtime (it lives in
# devDependencies), so --prod alone crash-loops with ERR_MODULE_NOT_FOUND.
RUN pnpm install --frozen-lockfile
COPY dist ./dist
ENV NODE_ENV=production
EXPOSE 3100
CMD ["node", "dist/index.js"]
